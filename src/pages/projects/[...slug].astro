---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { sortProjects } from '../../lib/projects';
export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  const ordered = sortProjects(projects);
  return ordered.map((project, index) => {
    const peers = ordered.filter(p => p.data.group === project.data.group);
    const nextInGroup = peers[(peers.findIndex(p => p.id === project.id) + 1) % peers.length];
    return { params: { slug: project.id }, props: { project, next: ordered[(index + 1) % ordered.length], nextInGroup } };
  });
}
const { project, next, nextInGroup } = Astro.props;
const { Content } = await render(project);
const { title, subtitle, cover, category, status, links } = project.data;
---
<Base title={`${title} · hi · fangs`} description={subtitle} image={cover?.src} imageAlt={cover?.alt}>
  <SiteHeader />
  <main id="main" class="project-detail shell">
    <a href="/#works" class="back-link" data-return>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M20 12H5m6-6-6 6 6 6" /></svg>
      全部作品
    </a>
    <article>
      <header class="detail-heading fade-up">
        <div class="work-meta">{category ?? project.data.year} · {status}</div>
        <h1>{title}</h1>
        <p>{subtitle}</p>
        {links && links.length > 0 && <div class="project-actions">
          {links.map((link, index) => <a class={index === 0 ? 'project-action primary' : 'project-action'} href={link.href} target="_blank" rel="noopener noreferrer">
            {link.label}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M6 18 18 6M6 6h12v12" /></svg>
          </a>)}
        </div>}
      </header>
      {cover && <figure class="detail-cover"><img src={cover.src} alt={cover.alt} width="1200" height="750" fetchpriority="high" /></figure>}
      <div class="prose detail-body"><Content /></div>
      <nav class="detail-end" aria-label="继续浏览">
        <a href="/#works" data-return>← 回到作品</a>
        <a href={`/projects/${next.id}/`} class="next-project" data-group={project.data.group} data-filtered-href={`/projects/${nextInGroup.id}/`} data-filtered-title={nextInGroup.data.title}><span>下一件作品</span><strong>{next.data.title}</strong><span aria-hidden="true">↗</span></a>
      </nav>
    </article>
  </main>
  <SiteFooter />
</Base>

<script>import '../../scripts/detail';</script>
