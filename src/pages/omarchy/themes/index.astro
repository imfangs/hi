---
import Base from '../../../layouts/Base.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import ThemeMiniature from '../../../components/ThemeMiniature.astro';
import {themes} from '../../../lib/omarchy-themes';
---
<Base title="23 种设计风格 · Omarchy Theme Atlas" description="从 Omarchy 的23套色板出发，用同一套 daisyUI 组件比较不同设计语言。看样张、浏览原作、带走可复用的主题配置。">
 <link rel="stylesheet" href="/omarchy/themes/daisyui-themes.css" />
 <SiteHeader />
 <main id="main" class="shell atlas">
  <div class="atlas-intro"><div><p class="atlas-eyebrow">OMARCHY / THEME ATLAS</p><h1>23 种设计风格。</h1><p class="atlas-lead">同一套组件，换一种性格。<br/>看看哪一种，适合下一个想法。</p></div><div class="atlas-context"><p>Omarchy 原始色板 × daisyUI</p><p>原作预览、可操作样张、可带走的主题。<br/>字体、圆角与间距是我们为网页做的延伸。</p><a href="/omarchy/">返回字符屏保 ↗</a></div></div>
  <div class="atlas-toolbar" data-atlas-tools hidden><div class="atlas-filters" role="group" aria-label="明暗筛选"><button data-mode="all" aria-pressed="true">全部 <span>23</span></button><button data-mode="light" aria-pressed="false">浅色 <span>5</span></button><button data-mode="dark" aria-pressed="false">深色 <span>18</span></button></div><label class="atlas-search"><span class="sr-only">搜索风格</span><input type="search" placeholder="搜索名字、气质或用途" data-atlas-search /></label><span data-count aria-live="polite">23 种风格</span></div>
  <div class="atlas-grid">{themes.map(t=><a class="atlas-card" id={`theme-${t.id}`} href={`/omarchy/themes/${t.id}/`} data-theme-card data-mode={t.mode} data-search={`${t.name} ${t.style.label} ${t.style.group} ${t.style.use}`}><ThemeMiniature theme={t}/><div class="atlas-card-title"><h2>{t.name}</h2><span>↗</span></div><div class="atlas-card-caption"><p>{t.style.label}<span> · {t.mode==='light'?'浅色':'深色'}</span></p><div class="atlas-swatches" aria-hidden="true">{['background','foreground','accent','red','green','blue'].map(key=><i style={`background:${t.palette[key as keyof typeof t.palette]}`}></i>)}</div></div></a>)}</div>
  <p class="atlas-empty" data-atlas-empty hidden>没有找到这个风格，换个词试试。</p>
  <footer class="atlas-note"><p>这些是从原始配色延伸的网页预设，不是 Omarchy 官方网页设计系统。<br/>先在一个真实页面里验证，再决定是否迁移。</p><a href="https://github.com/omacom/omarchy" target="_blank" rel="noreferrer">Omarchy 原作 ↗</a></footer>
 </main><SiteFooter />
</Base>
<script>
 const tools=document.querySelector('[data-atlas-tools]') as HTMLElement;tools.hidden=false;
 const input=document.querySelector('[data-atlas-search]') as HTMLInputElement;
 let mode=new URLSearchParams(location.search).get('mode')??'all';if(!['all','light','dark'].includes(mode))mode='all';input.value=new URLSearchParams(location.search).get('q')??'';
 function filter(){let count=0;document.querySelectorAll<HTMLElement>('[data-theme-card]').forEach(card=>{const show=(mode==='all'||card.dataset.mode===mode)&&card.dataset.search!.toLowerCase().includes(input.value.trim().toLowerCase());card.hidden=!show;if(show)count++;});document.querySelectorAll<HTMLElement>('[data-atlas-tools] [data-mode]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.mode===mode)));document.querySelector('[data-count]')!.textContent=`${count} 种风格`;(document.querySelector('[data-atlas-empty]') as HTMLElement).hidden=count!==0;const url=new URL(location.href);mode==='all'?url.searchParams.delete('mode'):url.searchParams.set('mode',mode);input.value?url.searchParams.set('q',input.value):url.searchParams.delete('q');history.replaceState(null,'',url);}
 input.oninput=filter;document.querySelectorAll<HTMLElement>('[data-atlas-tools] [data-mode]').forEach(b=>b.onclick=()=>{mode=b.dataset.mode!;filter();});filter();
</script>
<style>
.atlas{padding-top:60px;padding-bottom:75px}.atlas-intro{display:flex;align-items:end;justify-content:space-between;gap:40px;margin-bottom:52px}.atlas-eyebrow{font:11px/1.4 var(--font-sans);letter-spacing:.12em;color:var(--color-ink-muted);margin-bottom:22px}.atlas h1{font-size:clamp(38px,5vw,62px);line-height:1.25}.atlas-lead{font:18px/1.85 var(--font-sans);color:var(--color-ink-muted);margin-top:22px}.atlas-context{max-width:340px;font:12px/1.9 var(--font-sans);color:var(--color-ink-muted)}.atlas-context p+p{margin-top:14px}.atlas-context a{display:inline-flex;align-items:center;min-height:44px;margin-top:10px;color:var(--color-ink)}.atlas-toolbar{display:flex;align-items:center;gap:24px;border-top:1px solid var(--color-rule);border-bottom:1px solid var(--color-rule);padding:8px 0;margin-bottom:32px}.atlas-filters{display:flex;gap:28px}.atlas-filters button{background:none;border:0;padding:8px 0;min-height:44px;font-size:13px;color:var(--color-ink-muted)}.atlas-filters button[aria-pressed=true]{color:var(--color-ink);box-shadow:inset 0 -1px currentColor}.atlas-filters span{font-size:10px;margin-left:4px;opacity:.7}.atlas-search{margin-left:auto}.atlas-search input{font:13px var(--font-sans);background:none;color:var(--color-ink);border:0;border-bottom:1px solid var(--color-rule);padding:12px 0;width:210px;min-height:44px}.atlas-toolbar>[data-count]{font-size:11px;color:var(--color-ink-muted)}.atlas-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:44px 28px}.atlas-card{display:block;min-width:0;scroll-margin-top:20px}.atlas-card-title{display:flex;align-items:center;justify-content:space-between;margin-top:19px;gap:10px}.atlas-card-title h2{font:500 20px/1.4 var(--font-sans);letter-spacing:-.03em}.atlas-card-title>span{transition:transform .2s}.atlas-card:hover .atlas-card-title>span{transform:translate(3px,-3px)}.atlas-card-caption{display:flex;justify-content:space-between;gap:8px;align-items:center;margin-top:6px}.atlas-card-caption p{font-size:12px;color:var(--color-ink-muted)}.atlas-card-caption p>span{font-size:10px;opacity:.7}.atlas-swatches{display:flex;gap:3px}.atlas-swatches i{height:11px;width:11px;border-radius:50%;border:1px solid #8883}.atlas-note{border-top:1px solid var(--color-rule);margin-top:70px;padding-top:25px;font:12px/1.9 var(--font-sans);color:var(--color-ink-muted);display:flex;justify-content:space-between;gap:24px}.atlas-note a{flex-shrink:0;min-height:44px;display:flex;align-items:center}.atlas-empty{padding:70px 0;text-align:center}@media(max-width:1100px){.atlas-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:700px){.atlas{padding-top:30px}.atlas-intro{display:block;margin-bottom:32px}.atlas-context{margin-top:24px}.atlas-lead{font-size:16px}.atlas-toolbar{flex-wrap:wrap;gap:6px 15px}.atlas-filters{gap:24px}.atlas-search{order:3;width:100%;margin-left:0}.atlas-search input{width:100%}.atlas-toolbar>[data-count]{margin-left:auto}.atlas-grid{grid-template-columns:1fr;gap:34px}.atlas-note{display:block}}
</style>
