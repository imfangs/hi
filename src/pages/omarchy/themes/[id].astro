---
import Base from '../../../layouts/Base.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import ThemePlayground from '../../../components/ThemePlayground.astro';
import {themes,themeSource} from '../../../lib/omarchy-themes';
export function getStaticPaths() {
  return themes.map((entry, ordinal) => ({params: {id: entry.id}, props: {theme: entry, index: ordinal}}));
}
const {theme:t,index}=Astro.props;
const next=themes[(index+1)%themes.length];
const paletteKeys=[['background','背景'],['foreground','文字'],['accent','强调'],['selection','选中'],['red','红'],['yellow','黄'],['green','绿'],['cyan','青'],['blue','蓝'],['magenta','紫']];
---
<Base title={`${t.name} · ${t.style.label} · 设计风格图鉴`} description={`${t.style.description} 用 daisyUI 组件试用这套风格，查看 Omarchy 原作预览、壁纸和可复用的主题配置。`} image={t.preview.src}>
 <link rel="stylesheet" href="/omarchy/themes/daisyui-themes.css"/><SiteHeader/>
 <main id="main" class="shell style-detail">
  <nav class="style-breadcrumb"><a href={`/omarchy/themes/#theme-${t.id}`}>← 全部 23 种风格</a><a href={`/omarchy/themes/${next.id}/`}>下一种 · {next.name} ↗</a></nav>
  <header class="style-heading"><div><p>{t.style.group} · {t.mode==='light'?'浅色':'深色'}</p><h1>{t.name}</h1><h2>{t.style.label}</h2></div><p class="style-summary">{t.style.description}</p></header>
  <nav class="style-jump" aria-label="本页内容"><a href="#playground">试用组件</a><a href="#decisions">设计取舍</a><a href="#original">原作与壁纸</a><a href="#take-away">带走主题</a></nav>
  <section id="playground" class="style-section"><h2 class="style-section-title">放进一个真实界面里。</h2><ThemePlayground theme={t}/></section>
  <section id="decisions" class="style-section style-decisions"><div><p class="style-kicker">网页设计延伸</p><h2>借的不只是颜色。</h2><p>{t.style.principle}</p></div><dl><div><dt>值得试的场景</dt><dd>{t.style.use}。这是我们的适配判断，仍需真实内容验证。</dd></div><div><dt>字形与轮廓</dt><dd>{t.style.font==='serif'?'衬线标题，正文保持清晰。':t.style.font==='mono'?'等宽文字，强调结构与节奏。':'无衬线标题与正文，强调清晰的层级。'} {t.style.radius}px 圆角、{t.style.space}px 内容间距。</dd></div><div><dt>迁移时先验证</dt><dd>拿一张已有页面替换主题，观察中文、长标题、表单与状态是否仍清楚；先验证，再扩大范围。</dd></div></dl></section>
  <section class="style-section"><h2 class="style-section-title">原始色板</h2><p class="style-explanation">取自该主题的 colors.toml。网页按钮文字另按黑白对比选择，组件形状与间距为本图鉴的延伸。</p><div class="palette-grid">{paletteKeys.map(([key,label])=><div class="palette-item"><i style={`background:${t.palette[key as keyof typeof t.palette]}`}></i><span>{label}<small>{key}</small></span><code>{t.palette[key as keyof typeof t.palette]}</code></div>)}</div></section>
  <section id="original" class="style-section"><div class="style-section-head"><h2 class="style-section-title">回到 Omarchy 原作</h2><a href={t.source} target="_blank" rel="noreferrer">查看主题源码 ↗</a></div><p class="style-explanation">以下是官方源码附带的桌面预览与壁纸，不是我们的网页样张，也不是本机运行截图。点击图片查看大图。</p><a class="official-preview" href={t.preview.src} data-art data-original={t.preview.original}><img src={t.preview.src} width={t.preview.width} height={t.preview.height} alt={`${t.name} 官方桌面预览：终端、代码编辑器和文件窗口`} loading="lazy"/></a><p class="image-caption">官方桌面预览 · 原文件 2560 × 1440</p>
   <div class="wallpaper-grid">{t.backgrounds.map(bg=><a href={bg.src} data-art data-original={bg.original}><img src={bg.src} width={bg.width} height={bg.height} loading="lazy" alt={`${t.name} 壁纸 ${bg.name}`}/><span>{bg.name.replace(/^[0-9]+[-_]/,'').replace(/[-_]/g,' ')} ↗</span></a>)}</div>
   {t.unlock&&<details class="unlock-preview"><summary>看看官方解锁画面</summary><a href={t.unlock.src} data-art data-original={t.unlock.original}><img src={t.unlock.src} width={t.unlock.width} height={t.unlock.height} loading="lazy" alt={`${t.name} 官方解锁画面预览`}/></a></details>}
  </section>
  <section id="take-away" class="style-section takeaway"><div><p class="style-kicker">TAILWIND 4 + DAISYUI 5</p><h2>把这套风格带走。</h2><p>CSS 可直接接入 daisyUI；JSON 保留原始色板与我们的网页设计参数，方便迁移到其他组件库。</p></div><div><div class="download-links"><a href={`/omarchy/themes/presets/${t.id}.css`} download>下载这套 CSS ↧</a><a href={`/omarchy/themes/presets/${t.id}.json`} download>下载设计参数 JSON ↧</a><a href="/omarchy/themes/daisyui-themes.css" download>全部 23 套 CSS ↧</a><a href="/omarchy/themes/starter.zip" download>最小可运行项目 ↧</a></div><pre><code>{`@import "tailwindcss";\n@import "./${t.id}.css";\n@plugin "daisyui" { themes: false; }\n\n/* 使用 data-theme="omarchy-${t.id}" */\n/* 圆角自动映射到组件；排版使用 --style-* 变量 */`}</code></pre></div></section>
  <footer class="style-source"><p>原作：<a href="https://omarchy.org/" target="_blank" rel="noreferrer">Omarchy</a> · 组件：<a href="https://daisyui.com/" target="_blank" rel="noreferrer">daisyUI</a> · 中文解读与网页适配：fangs / 格得。<br/>源码快照 {themeSource.date} · <a href={`https://github.com/omacom/omarchy/tree/${themeSource.revision}`} target="_blank" rel="noreferrer">{themeSource.revision.slice(0,8)}</a>。图像保留原文件入口，版权归原作者；仓库许可随主题配置保留。</p><a href="/omarchy/themes/">再看另一种风格 ↗</a></footer>
 <dialog class="art-view" data-art-dialog><div><p data-art-caption></p><button type="button" data-art-close aria-label="关闭大图">✕</button></div><img data-art-image alt=""/><a data-art-original target="_blank" rel="noreferrer">查看上游原文件 ↗</a></dialog>
 </main><SiteFooter/>
</Base>
<script>
 const dialog=document.querySelector('[data-art-dialog]') as HTMLDialogElement,image=dialog.querySelector('[data-art-image]') as HTMLImageElement;
 document.querySelectorAll<HTMLAnchorElement>('[data-art]').forEach(a=>a.onclick=e=>{e.preventDefault();image.src=a.href;image.alt=a.querySelector('img')!.alt;dialog.querySelector('[data-art-caption]')!.textContent=image.alt;(dialog.querySelector('[data-art-original]') as HTMLAnchorElement).href=a.dataset.original!;dialog.showModal();});
 (document.querySelector('[data-art-close]') as HTMLButtonElement).onclick=()=>dialog.close();dialog.onclick=e=>{if(e.target===dialog)dialog.close();};
</script>
<style>
.art-view{max-width:min(1500px,96vw);width:96vw;max-height:94svh;border:1px solid #555;background:#111;color:#eee;padding:18px}.art-view::backdrop{background:#000d}.art-view>div{display:flex;align-items:center;justify-content:space-between;gap:20px}.art-view p{font:12px/1.7 system-ui}.art-view button{background:none;border:0;color:inherit;font-size:20px;min-width:44px;min-height:44px}.art-view img{width:100%;height:auto;max-height:75svh;object-fit:contain}.art-view>a{display:inline-flex;align-items:center;min-height:44px;font:12px system-ui;margin-top:5px}

.style-detail{padding-top:24px;padding-bottom:70px}.style-breadcrumb{display:flex;justify-content:space-between;gap:20px;font:12px/1.6 var(--font-sans);color:var(--color-ink-muted)}.style-breadcrumb a{display:flex;align-items:center;min-height:44px}.style-heading{display:flex;align-items:end;justify-content:space-between;gap:50px;margin:45px 0 40px}.style-heading>div>p{font:11px/1.6 var(--font-sans);color:var(--color-ink-muted);margin-bottom:13px}.style-heading h1{font:500 clamp(38px,5.5vw,70px)/1.1 var(--font-sans);letter-spacing:-.055em}.style-heading h2{font-size:21px;margin-top:18px}.style-summary{max-width:400px;font:17px/1.9 var(--font-sans);color:var(--color-ink-muted)}.style-jump{display:flex;gap:32px;border-block:1px solid var(--color-rule);font:12px/1.5 var(--font-sans)}.style-jump a{min-height:50px;display:flex;align-items:center}.style-section{margin-top:65px;scroll-margin-top:25px}.style-section-title{font-size:27px;line-height:1.5;margin-bottom:23px}.style-section-head{display:flex;align-items:center;justify-content:space-between;gap:24px}.style-section-head a{font-size:12px;min-height:44px;display:flex;align-items:center}.style-explanation{font:13px/1.9 var(--font-sans);color:var(--color-ink-muted);max-width:760px;margin:-8px 0 24px}.style-decisions{display:grid;grid-template-columns:1fr 1fr;gap:70px;padding:38px 0;border-block:1px solid var(--color-rule)}.style-kicker{font:10px/1.5 var(--font-sans);letter-spacing:.06em;color:var(--color-ink-muted);margin-bottom:14px}.style-decisions h2,.takeaway h2{font-size:29px;line-height:1.4}.style-decisions>div>p:last-child,.takeaway>div>p:last-child{font:15px/1.9 var(--font-sans);color:var(--color-ink-muted);margin-top:20px;max-width:450px}.style-decisions dl{margin:0}.style-decisions dl>div+div{margin-top:23px}.style-decisions dt{font:600 13px/1.7 var(--font-sans)}.style-decisions dd{margin:6px 0 0;font:13px/1.9 var(--font-sans);color:var(--color-ink-muted)}.palette-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:16px}.palette-item{border:1px solid var(--color-rule);min-width:0}.palette-item i{display:block;height:80px;border-bottom:1px solid #8883}.palette-item>span{display:block;font-size:13px;padding:12px 12px 0}.palette-item small{display:block;font:9px/1.7 var(--font-mono);color:var(--color-ink-muted);margin-top:3px}.palette-item code{display:block;padding:8px 12px 12px;font:11px/1.4 var(--font-mono)}.official-preview{display:block;background:#111}.official-preview img{width:100%;height:auto}.image-caption{font-size:11px;color:var(--color-ink-muted);margin-top:10px}.wallpaper-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:30px}.wallpaper-grid a{min-width:0}.wallpaper-grid img{width:100%;height:auto;aspect-ratio:16/10;object-fit:contain;background:var(--color-surface)}.wallpaper-grid span{display:block;font:11px/1.6 var(--font-sans);color:var(--color-ink-muted);margin-top:8px}.unlock-preview{margin-top:30px;font-size:13px}.unlock-preview summary{cursor:pointer;min-height:44px;padding:14px 0}.unlock-preview img{max-width:100%;height:auto;margin-top:12px}.takeaway{display:grid;grid-template-columns:1fr 1fr;gap:60px;border-top:1px solid var(--color-rule);padding-top:40px}.takeaway>div{min-width:0}.download-links{display:flex;flex-wrap:wrap;gap:8px 24px;font-size:12px}.download-links a{min-height:44px;display:flex;align-items:center;border-bottom:1px solid var(--color-rule)}.takeaway pre{margin:20px 0 0;padding:20px;background:var(--color-surface);font:11px/1.9 var(--font-mono);overflow:auto;border:1px solid var(--color-rule)}.style-source{display:flex;justify-content:space-between;align-items:start;gap:40px;font:11px/1.9 var(--font-sans);color:var(--color-ink-muted);margin-top:65px;border-top:1px solid var(--color-rule);padding-top:24px}.style-source>a{min-height:44px;display:flex;align-items:center;flex-shrink:0}@media(max-width:850px){.style-decisions,.takeaway{grid-template-columns:1fr;gap:30px}.palette-grid{grid-template-columns:repeat(3,1fr)}}@media(max-width:700px){.style-heading{display:block;margin:30px 0}.style-summary{margin-top:22px;font-size:15px}.style-jump{gap:20px}.style-section{margin-top:42px}.style-section-title{font-size:24px}.wallpaper-grid{grid-template-columns:repeat(2,1fr);gap:15px}.palette-grid{gap:10px;grid-template-columns:repeat(2,1fr)}.palette-item i{height:64px}.style-source{display:block}.style-source>a{margin-top:15px}.style-breadcrumb{font-size:10px;gap:15px}.style-section-head{display:block}}
</style>
