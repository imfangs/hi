---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectRow from '../components/ProjectRow.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { groups, sortProjects } from '../lib/projects';
const featured = sortProjects(await getCollection('projects', ({ data }) => !data.draft && data.featured));
---
<Base title="hi · fangs — Taste. Build. Sell." description="Taste. Build. Sell. 判断什么值得做，把它做出来，让真实的人愿意用。fangs 的原生 App、网页游戏、阅读与创作。" image="/images/projects/lehh.webp">
  <SiteHeader />
  <main id="main" class="portfolio shell">
    <header class="intro">
      <h1>你好，我是 fangs。</h1>
      <p class="intro-slogan" lang="en"><span class="slogan-word">Taste<span class="slogan-dot">.</span></span> <span class="slogan-word">Build<span class="slogan-dot">.</span></span> <span class="slogan-word">Sell<span class="slogan-dot">.</span></span></p>
      <div class="intro-bottom"><p class="intro-belief">判断什么值得做，把它做出来，让真实的人愿意用。</p><a class="text-link" href="#works">看看作品 ↓</a></div>
    </header>
    <section id="works" aria-labelledby="works-title">
      <div class="section-heading"><h2 id="works-title">作品</h2><span>2026 / {featured.length} 件作品</span></div>
      <div class="filter-bar" role="group" aria-label="筛选作品" hidden>
        {groups.map(group => <button type="button" data-filter={group.id} aria-pressed={group.id === 'all'} aria-controls="work-list">{group.label}<span>{group.id === 'all' ? featured.length : featured.filter(p => p.data.group === group.id).length}</span></button>)}
      </div>
      <p class="sr-only" role="status" id="filter-status"></p>
      <ul class="work-list" id="work-list">{featured.map((project, index) => <ProjectRow project={project} eager={index < 2} />)}</ul>
    </section>
    <section class="about" id="about" aria-labelledby="about-title">
      <p class="about-label">关于</p>
      <div class="about-layout">
        <div class="about-copy">
          <h2 id="about-title">慢慢做，<br />认真玩。</h2>
          <p>从原生 App、网页游戏，到艺术与阅读的小站，我喜欢把好奇心做成可以亲手体验的东西。</p>
          <p>和我的最佳拍档格得一起，琢磨、动手，再让真实的使用告诉我们哪里还值得打磨。</p>
          <a class="text-link" href="https://ged.fangs.cc/">去格得的小站坐坐 ↗</a>
        </div>
        <a class="about-artwork" href="/images/brand/palm-forward-1536.webp" target="_blank" rel="noopener noreferrer" aria-label="掌心之光，查看大图">
          <figure>
            <img
              src="/images/brand/palm-forward-1536.webp"
              srcset="/images/brand/palm-forward-768.webp 768w, /images/brand/palm-forward-1536.webp 1536w"
              sizes="(max-width: 700px) calc(100vw - 40px), (max-width: 1100px) 52vw, (max-width: 1440px) 50vw, 700px"
              width="1536" height="1024" loading="lazy" decoding="async"
              alt="向前伸出的手掌，掌心的 TBS 三角字徽向右射出金色光束。"
            />
            <figcaption><span>掌心之光</span><span class="artwork-open">查看大图<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M6 18 18 6M6 6h12v12" /></svg></span></figcaption>
          </figure>
        </a>
      </div>
    </section>
  </main>
  <SiteFooter />
</Base>
<script>import '../scripts/gallery';</script>
