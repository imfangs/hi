---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectRow from '../components/ProjectRow.astro';
import SiteFooter from '../components/SiteFooter.astro';
const all = await getCollection('projects', ({ data }) => !data.draft);
const sorted = all.sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999));
const featured = sorted.filter(({ data }) => data.featured);
const earlier = sorted.filter(({ data }) => !data.featured);
---
<Base title="hi · fangs" image="/images/projects/junlugu.webp">
  <main id="main" class="portfolio">
    <header class="intro fade-up">
      <h1>你好，我是 fangs。</h1>
      <p>写程序，也用 AI 做一些想用、想玩的东西。</p>
      <nav class="contact-links" aria-label="联系我">
        <a href="https://github.com/imfangs" target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href="mailto:mafangshuai@126.com">Email</a>
      </nav>
    </header>
    <section aria-labelledby="works-title">
      <div class="section-heading">
        <h2 id="works-title">作品</h2>
        <span>{featured.length} 个项目 · 2026</span>
      </div>
      <ul class="work-list">
        {featured.map((project, index) => <ProjectRow project={project} eager={index < 2} />)}
      </ul>
    </section>
    {earlier.length > 0 && <section class="earlier-work" aria-labelledby="earlier-title">
      <h2 id="earlier-title">早期探索</h2>
      <ul>{earlier.map((project) => <li><a href={`/projects/${project.id}/`}>
        <span>{project.data.title}</span><span>{project.data.subtitle}</span>
      </a></li>)}</ul>
    </section>}
  </main>
  <SiteFooter />
</Base>
