---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectRow from '../components/ProjectRow.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { groups, sortProjects } from '../lib/projects';
import { arrangeExhibition } from '../lib/exhibition';
const featured = arrangeExhibition(sortProjects(await getCollection('projects', ({ data }) => !data.draft && data.featured)));
---
<Base title="hi · fangs — Taste. Build. Sell." description="Taste. Build. Sell. 判断什么值得做，把它做出来，让真实的人愿意用。fangs 的原生 App、网页游戏、阅读与创作。" image="/images/projects/lehh.webp">
  <SiteHeader />
  <main id="main" class="portfolio shell">
    <header class="intro">
      <h1 class="intro-slogan" lang="en"><span class="slogan-word">Taste.</span> <span class="slogan-word">Build.</span> <span class="slogan-word">Sell.</span></h1>
    </header>
    <section id="works" aria-labelledby="works-title">
      <h2 id="works-title" class="sr-only">作品</h2>
      <div class="browse-sentinel" aria-hidden="true"></div>
      <div class="browse-toolbar" hidden>
        <div class="filter-bar" role="group" aria-label="筛选作品">
          {groups.map(group => <button type="button" data-filter={group.id} aria-pressed={group.id === 'all'} aria-controls="work-list">{group.label}</button>)}
        </div>
        <div class="work-search" role="search" aria-label="搜索作品">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg>
          <label class="sr-only" for="work-search">搜索作品名称、用途或技术</label>
          <input id="work-search" type="search" placeholder="搜索名称或用途" maxlength="80" autocomplete="off" spellcheck="false" aria-controls="work-list" />
          <kbd class="search-shortcut" aria-hidden="true">/</kbd>
          <button class="search-clear" type="button" aria-label="清除搜索" hidden><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg></button>
        </div>
      </div>
      <p class="sr-only" role="status" id="filter-status"></p>
      <ul class="work-list" id="work-list" data-layout="exhibition">{featured.map((project, index) => <ProjectRow project={project} eager={index < 2} />)}</ul>
      <div class="work-empty" hidden>
        <p class="empty-eyebrow">换个线索，再找找</p>
        <h3 data-empty-title>暂时没有找到作品</h3>
        <p>试试作品名称、用途，或者看看其他分类。</p>
        <button type="button" data-reset-gallery>查看全部作品 <span aria-hidden="true">↗</span></button>
      </div>
    </section>
    <section class="about" id="about" aria-labelledby="about-title">
      <div class="about-layout">
        <div class="about-copy">
          <h2 id="about-title">慢慢做，<br />认真玩。</h2>
          <p>和格得一起，把好奇心做成可以亲手体验的东西。</p>
        </div>
        <a class="about-artwork" href="/images/brand/palm-forward-1536.webp" target="_blank" rel="noopener noreferrer" aria-label="掌心之光，查看大图">
          <figure>
            <img
              src="/images/brand/palm-forward-1536.webp"
              srcset="/images/brand/palm-forward-768.webp 768w, /images/brand/palm-forward-1536.webp 1536w"
              sizes="(max-width: 700px) calc(100vw - 40px), (max-width: 1100px) 52vw, (max-width: 1440px) 50vw, 700px"
              width="1536" height="1024" loading="lazy" decoding="async"
              alt="向前伸出的手掌，掌心的 TBS 三角字徽向右射出金色光束。"
            />
            <figcaption><span>掌心之光</span><span class="artwork-open">查看大图<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M6 18 18 6M6 6h12v12" /></svg></span></figcaption>
          </figure>
        </a>
      </div>
    </section>
  </main>
  <SiteFooter />
</Base>
<script>import '../scripts/gallery';</script>
