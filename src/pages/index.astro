---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectRow from '../components/ProjectRow.astro';
import SiteFooter from '../components/SiteFooter.astro';
const all = await getCollection('projects', ({ data }) => !data.draft);
const sorted = all.sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999));
const featured = sorted.filter(({ data }) => data.featured);
---
<Base title="hi · fangs" description="Taste. Build. Sell. 判断什么值得做，把它做出来，让真实的人愿意用。" image="/images/projects/junlugu.webp">
  <main id="main" class="portfolio">
    <header class="intro fade-up">
      <h1>你好，我是 fangs。</h1>
      <p class="intro-slogan" lang="en">Taste<span>.</span> Build<span>.</span> Sell<span>.</span></p>
      <p class="intro-belief">判断什么值得做，把它做出来，让真实的人愿意用。</p>
      <nav class="contact-links" aria-label="联系我">
        <a href="https://github.com/imfangs" target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href="mailto:mafangshuai@126.com">Email</a>
      </nav>
    </header>
    <section aria-labelledby="works-title">
      <div class="section-heading">
        <h2 id="works-title">作品</h2>
        <span>{featured.length} 个项目 · 2026</span>
      </div>
      <ul class="work-list">
        {featured.map((project, index) => <ProjectRow project={project} eager={index < 2} />)}
      </ul>
    </section>
  </main>
  <SiteFooter />
</Base>
