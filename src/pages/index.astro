---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const all = await getCollection('projects', ({ data }) => !data.draft);

// 按年份倒序、年份内按 order 升序
const sorted = all.sort((a, b) => {
  if (b.data.year !== a.data.year) return b.data.year - a.data.year;
  return (a.data.order ?? 999) - (b.data.order ?? 999);
});

const grouped = sorted.reduce<Record<number, typeof sorted>>((acc, p) => {
  (acc[p.data.year] ??= []).push(p);
  return acc;
}, {});

const years = Object.keys(grouped)
  .map(Number)
  .sort((a, b) => b - a);
---

<Base title="hi · fangs">
  <main class="min-h-[100dvh] flex items-center">
    <div class="mx-auto w-full max-w-[1080px] px-6 md:px-12 py-16">
      <div class="grid grid-cols-1 md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] gap-x-16 gap-y-12">

        {/* 左：介绍 */}
        <section class="fade-up">
          <h1 style="font-size: var(--text-2xl); margin-bottom: 0.4em;">
            你好。
          </h1>
          <h1 style="font-size: var(--text-2xl); margin-bottom: 1.2em;">
            我是 fangs。
          </h1>
          <p class="text-ink-muted" style="font-size: var(--text-lg);">
            一个写程序的人，<br />最近在用 AI 做一些项目。
          </p>

          <div class="mt-12 flex gap-6 meta">
            <a
              href="https://github.com/imfangs"
              class="hover:text-accent transition-colors duration-200"
              target="_blank"
              rel="noopener noreferrer"
            >
              github
            </a>
            <a
              href="mailto:mafangshuai@126.com"
              class="hover:text-accent transition-colors duration-200"
            >
              email
            </a>
          </div>
        </section>

        {/* 右：项目列表 */}
        <section class="fade-up" style="animation-delay: 120ms;">
          <div class="label mb-6">项目</div>

          {years.map((year) => (
            <div class="mb-6">
              <div class="meta mb-3">{year}</div>
              <ul class="space-y-4">
                {grouped[year].map((project) => (
                  <li>
                    <a
                      href={`/projects/${project.id}/`}
                      class="project-card block"
                    >
                      <div class="flex items-baseline gap-3">
                        <span
                          class="project-title shrink-0"
                          style="font-size: var(--text-lg); font-weight: 600;"
                        >
                          {project.data.title}
                        </span>
                        <span class="text-ink-muted truncate" style="font-size: var(--text-sm);">
                          {project.data.subtitle}
                        </span>
                      </div>
                      <div class="meta mt-1">
                        {project.data.stack.slice(0, 3).join(' · ')} · {project.data.status}
                      </div>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </section>

      </div>
    </div>
  </main>
</Base>
