---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectRow from '../components/ProjectRow.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { groups, sortProjects } from '../lib/projects';
const featured = sortProjects(await getCollection('projects', ({ data }) => !data.draft && data.featured));
---
<Base title="hi · fangs — Taste. Build. Sell." description="Taste. Build. Sell. 判断什么值得做，把它做出来，让真实的人愿意用。fangs 的原生 App、网页游戏、阅读与创作。" image="/images/projects/lehh.webp">
  <SiteHeader />
  <main id="main" class="portfolio shell">
    <header class="intro">
      <h1>你好，我是 fangs。</h1>
      <p class="intro-slogan" lang="en">Taste<span>.</span> Build<span>.</span> Sell<span>.</span></p>
      <div class="intro-bottom"><p class="intro-belief">判断什么值得做，把它做出来，让真实的人愿意用。</p><a class="text-link" href="#works">看看作品 ↓</a></div>
    </header>
    <section id="works" aria-labelledby="works-title">
      <div class="section-heading"><h2 id="works-title">作品</h2><span>2026 / {featured.length} 件作品</span></div>
      <div class="filter-bar" role="group" aria-label="筛选作品" hidden>
        {groups.map(group => <button type="button" data-filter={group.id} aria-pressed={group.id === 'all'} aria-controls="work-list">{group.label}<span>{group.id === 'all' ? featured.length : featured.filter(p => p.data.group === group.id).length}</span></button>)}
      </div>
      <p class="sr-only" role="status" id="filter-status"></p>
      <ul class="work-list" id="work-list">{featured.map((project, index) => <ProjectRow project={project} eager={index < 2} />)}</ul>
    </section>
    <section class="about" id="about" aria-labelledby="about-title">
      <p class="about-label">关于</p>
      <div><h2 id="about-title">慢慢做，<br />认真玩。</h2>
        <p>从原生 App、网页游戏，到艺术与阅读的小站，我喜欢把好奇心做成可以亲手体验的东西。</p>
        <p>和我的最佳拍档格得一起，琢磨、动手，再让真实的使用告诉我们哪里还值得打磨。</p>
        <a class="text-link" href="https://ged.fangs.cc/">去格得的小站坐坐 ↗</a>
      </div>
    </section>
  </main>
  <SiteFooter />
</Base>
<script>import '../scripts/gallery';</script>
