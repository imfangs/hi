---
import {themes,presetCss,makeTokens} from '../lib/omarchy-themes';
interface Props {theme:typeof themes[number]}
const {theme}=Astro.props;
const presets=themes.map(t=>({id:t.id,name:t.name,css:presetCss(t),font:t.style.font,radius:t.style.radius,space:t.style.space,tokens:makeTokens(t)}));
---
<div class="playground-tools"><label>比较风格 <select data-demo-picker>{themes.map(t=><option value={t.id} selected={t.id===theme.id}>{t.name} · {t.style.label}</option>)}</select></label><a data-demo-detail href={`/omarchy/themes/${theme.id}/`}>打开该风格详情 ↗</a><button data-copy-theme type="button">复制主题 CSS</button></div>
<p class="playground-hint">同一套 daisyUI 组件。切换风格会保留你输入的内容；以下操作仅作用于当前样张。</p>
<div id="design-demo" class="design-demo" data-theme={`omarchy-${theme.id}`}>
 <div class="demo-bar"><strong>小小工作室</strong><span data-demo-name>{theme.name}</span><label><input class="ds-toggle ds-toggle-primary ds-toggle-sm" type="checkbox" data-demo-filter/> 只看未完成</label></div>
 <div class="demo-body"><div class="demo-heading"><div><p>留给下一件作品</p><h3>把好奇心，<br/>做成可以体验的东西。</h3></div><span class="ds-badge ds-badge-outline">本地样张</span></div>
 <div class="demo-columns"><section class="ds-card demo-form-card"><div class="ds-card-body"><h4>一个新想法</h4><form data-demo-form><label>给它起个名字<input class="ds-input" name="title" value="周末的小作品" maxlength="40" required/></label><label>它会是什么<select class="ds-select" name="kind"><option>一个网站</option><option>一段阅读</option><option>一个小工具</option></select></label><label class="demo-check"><input type="checkbox" name="ready" class="ds-checkbox ds-checkbox-primary ds-checkbox-sm"/> 已经有一个可以测试的小样</label><div class="demo-form-actions"><button class="ds-btn ds-btn-primary" type="submit">加入工作室</button><button class="ds-btn ds-btn-ghost" type="reset">重置</button></div><p data-demo-message role="status" aria-live="polite"></p></form></div></section>
 <section class="demo-list"><div class="demo-list-heading"><h4>桌上的几件事</h4><span data-demo-count>3 个想法</span></div><div class="demo-table-wrap"><table class="ds-table"><thead><tr><th>作品 / 想法</th><th>状态</th><th><span class="sr-only">完成</span></th></tr></thead><tbody data-demo-rows><tr data-done="false"><td>观察一件喜欢的作品<small>一段阅读</small></td><td><span class="ds-badge ds-badge-soft ds-badge-secondary">灵感</span></td><td><input type="checkbox" class="ds-checkbox ds-checkbox-primary ds-checkbox-sm" aria-label="完成观察一件喜欢的作品"/></td></tr><tr data-done="false"><td>做一个可玩的页面<small>一个网站</small></td><td><span class="ds-badge ds-badge-soft ds-badge-primary">制作中</span></td><td><input type="checkbox" class="ds-checkbox ds-checkbox-primary ds-checkbox-sm" aria-label="完成做一个可玩的页面"/></td></tr><tr data-done="true"><td>记下这次真实反馈<small>一段阅读</small></td><td><span class="ds-badge ds-badge-soft ds-badge-success">已完成</span></td><td><input type="checkbox" checked class="ds-checkbox ds-checkbox-primary ds-checkbox-sm" aria-label="完成记下这次真实反馈"/></td></tr></tbody></table></div><p class="demo-status-line">完成情况 <span data-demo-completed>1 / 3</span></p><progress class="ds-progress ds-progress-primary" data-demo-progress value="1" max="3"></progress></section></div>
 </div>
</div>
<div class="playground-meta"><span data-demo-properties>{theme.style.font==='serif'?'衬线标题':theme.style.font==='mono'?'等宽文字':'无衬线标题'} · {theme.style.radius}px 圆角 · {theme.style.space}px 间距</span><span data-copy-status role="status" aria-live="polite"></span></div>
<script type="application/json" id="design-presets" set:html={JSON.stringify(presets)} />
<script>
 const presets=JSON.parse(document.querySelector('#design-presets')!.textContent!);
 const picker=document.querySelector('[data-demo-picker]') as HTMLSelectElement,demo=document.querySelector('#design-demo') as HTMLElement;
 const form=document.querySelector('[data-demo-form]') as HTMLFormElement,rows=document.querySelector('[data-demo-rows]') as HTMLElement;
 const filter=document.querySelector('[data-demo-filter]') as HTMLInputElement,initialRows=rows.innerHTML;
 function updateRows(){const list=[...rows.querySelectorAll<HTMLElement>('tr')],done=list.filter(r=>r.dataset.done==='true').length;list.forEach(r=>r.hidden=filter.checked&&r.dataset.done==='true');document.querySelector('[data-demo-count]')!.textContent=`${list.length} 个想法`;document.querySelector('[data-demo-completed]')!.textContent=`${done} / ${list.length}`;const p=document.querySelector('[data-demo-progress]') as HTMLProgressElement;p.max=list.length;p.value=done;}
 picker.onchange=()=>{const p=presets.find((p:{id:string})=>p.id===picker.value);demo.dataset.theme=`omarchy-${p.id}`;document.querySelector('[data-demo-name]')!.textContent=p.name;(document.querySelector('[data-demo-detail]') as HTMLAnchorElement).href=`/omarchy/themes/${p.id}/`;document.querySelector('[data-demo-properties]')!.textContent=`${p.font==='serif'?'衬线标题':p.font==='mono'?'等宽文字':'无衬线标题'} · ${p.radius}px 圆角 · ${p.space}px 间距`;document.querySelector('[data-copy-status]')!.textContent='';};
 form.onsubmit=e=>{e.preventDefault();const data=new FormData(form),title=String(data.get('title')??'').trim();if(!title)return;const tr=document.createElement('tr');tr.dataset.done='false';const td=document.createElement('td');td.append(document.createTextNode(title));const small=document.createElement('small');small.textContent=String(data.get('kind'));td.append(small);const status=document.createElement('td'),badge=document.createElement('span');badge.className='ds-badge ds-badge-soft ds-badge-primary';badge.textContent=data.has('ready')?'待测试':'新想法';status.append(badge);const action=document.createElement('td'),input=document.createElement('input');input.type='checkbox';input.className='ds-checkbox ds-checkbox-primary ds-checkbox-sm';input.setAttribute('aria-label',`完成${title}`);action.append(input);tr.append(td,status,action);rows.append(tr);updateRows();document.querySelector('[data-demo-message]')!.textContent=`「${title}」已加入这张样例。`;};
 form.onreset=()=>{rows.innerHTML=initialRows;filter.checked=false;updateRows();document.querySelector('[data-demo-message]')!.textContent='样张已重置。';};
 rows.onchange=e=>{const input=e.target as HTMLInputElement;if(input.type!=='checkbox')return;const row=input.closest('tr')!;row.dataset.done=String(input.checked);row.querySelector('.ds-badge')!.textContent=input.checked?'已完成':'进行中';updateRows();};filter.onchange=updateRows;
 (document.querySelector('[data-copy-theme]') as HTMLButtonElement).onclick=async()=>{const p=presets.find((p:{id:string})=>p.id===picker.value);try{await navigator.clipboard.writeText(p.css);document.querySelector('[data-copy-status]')!.textContent=`已复制 ${p.name} 的主题 CSS。`;}catch{document.querySelector('[data-copy-status]')!.textContent='未能访问剪贴板，请使用下方的 CSS 下载。';}};
</script>
<style>
.playground-tools{display:flex;gap:18px;align-items:center;flex-wrap:wrap;font:12px/1.5 var(--font-sans)}.playground-tools label{display:flex;align-items:center;gap:12px}.playground-tools select{font:13px var(--font-sans);padding:10px;background:var(--color-bg);color:var(--color-ink);border:1px solid var(--color-rule);max-width:270px;min-height:44px}.playground-tools button{margin-left:auto;background:none;border:1px solid var(--color-rule);padding:10px 16px;min-height:44px;font-size:12px}.playground-tools a{min-height:44px;display:flex;align-items:center}.playground-hint{font-size:12px;color:var(--color-ink-muted);margin:14px 0 20px;line-height:1.8}.design-demo{background:var(--color-base-100);color:var(--color-base-content);border:1px solid var(--color-base-300);border-radius:var(--radius-box);overflow:hidden;font-family:var(--style-body-font)}.demo-bar{display:flex;align-items:center;gap:25px;border-bottom:1px solid var(--color-base-300);padding:18px var(--style-space);font-size:12px}.demo-bar>span{opacity:.65;font-size:11px}.demo-bar label{margin-left:auto;display:flex;align-items:center;gap:10px;font-size:11px}.demo-body{padding:var(--style-space)}.demo-heading{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:28px}.demo-heading p{font-size:11px;opacity:.65;margin-bottom:12px}.demo-heading h3{font:500 clamp(25px,3.2vw,40px)/1.4 var(--style-heading-font);letter-spacing:-.04em}.demo-columns{display:grid;grid-template-columns:.85fr 1.15fr;gap:var(--style-space);align-items:start}.demo-form-card{background:var(--color-base-200);border:1px solid var(--color-base-300)}.demo-form-card .ds-card-body{padding:var(--style-space);gap:18px}.design-demo h4{font:600 16px/1.4 var(--style-heading-font)}.design-demo form{display:flex;flex-direction:column;gap:17px}.design-demo form>label{display:flex;flex-direction:column;gap:7px;font-size:12px}.design-demo form>.demo-check{flex-direction:row;align-items:center;font-size:11px}.design-demo form .ds-input,.design-demo form .ds-select{width:100%;font-size:13px;max-width:100%;box-sizing:border-box}.demo-form-actions{display:flex;gap:10px;flex-wrap:wrap}.demo-form-actions .ds-btn{font-size:12px}.design-demo [data-demo-message]{font-size:11px;line-height:1.7;min-height:1.7em}.demo-list{min-width:0;padding-top:4px}.demo-list-heading{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:16px}.demo-list-heading span{font-size:11px;opacity:.65}.demo-table-wrap{overflow:auto}.design-demo .ds-table{font-size:12px;width:100%}.design-demo :global(.ds-table td){white-space:normal;overflow-wrap:anywhere;padding:14px 9px}.design-demo :global(.ds-table td:first-child){min-width:120px}.design-demo :global(.ds-table td small){display:block;margin-top:6px;font-size:10px;opacity:.6}.design-demo :global(.ds-badge){font-size:10px;white-space:nowrap}.demo-status-line{display:flex;justify-content:space-between;font-size:11px;opacity:.75;margin:23px 0 10px}.playground-meta{display:flex;justify-content:space-between;gap:15px;font:11px/1.8 var(--font-sans);color:var(--color-ink-muted);margin-top:14px}@media(max-width:850px){.demo-columns{grid-template-columns:1fr}.playground-tools button{margin-left:0}}@media(max-width:500px){.demo-body{padding:18px}.demo-bar{padding:15px;gap:12px}.demo-bar>span{display:none}.demo-heading{align-items:start}.demo-heading .ds-badge{display:none}.playground-tools label{width:100%;justify-content:space-between}.playground-tools select{max-width:210px}.playground-tools{gap:8px 16px}.playground-meta{display:block}}
</style>
