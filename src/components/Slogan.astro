<div class="slogan-stage" data-slogan tabindex="0" aria-label="Taste. Build. Sell. 互动口号">
  <h1 class="intro-slogan" lang="en"><span class="slogan-word">Taste.</span> <span class="slogan-word">Build.</span> <span class="slogan-word">Sell.</span></h1>
  <canvas aria-hidden="true" style="width:100%;height:100%"></canvas>
</div>
<button class="slogan-pause" data-slogan-pause type="button" hidden aria-label="暂停口号动态" aria-pressed="false">Ⅱ</button>
<script>
  import {attachSlogan} from '../scripts/slogan-effects.js';
  const stage=document.querySelector('[data-slogan]') as HTMLElement;
  const button=document.querySelector('[data-slogan-pause]') as HTMLButtonElement;
  if(stage&&button){
    let control:Awaited<ReturnType<typeof attachSlogan>>,paused=false;
    async function start(){
      control=await attachSlogan(stage,{onState(state:string){button.hidden=state!=='ready';}});
      control.pause(paused);
    }
    button.onclick=()=>{paused=!paused;control?.pause(paused);button.textContent=paused?'▷':'Ⅱ';button.setAttribute('aria-label',paused?'继续口号动态':'暂停口号动态');button.setAttribute('aria-pressed',String(paused));};
    // The slogan is already readable; download the effect after the first page paint.
    requestAnimationFrame(()=>requestAnimationFrame(start));
    addEventListener('pagehide',()=>control?.destroy());
    addEventListener('pageshow',event=>{if(event.persisted)start();});
  }
</script>
