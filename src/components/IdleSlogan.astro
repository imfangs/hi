<div class="idle-hero" data-idle-hero>
  <h1 class="intro-slogan" lang="en">Taste. Build. Sell.</h1>
  <div class="idle-words" aria-hidden="true">
    <canvas data-idle-word="TASTE"></canvas><canvas data-idle-word="BUILD"></canvas><canvas data-idle-word="SELL"></canvas>
  </div>
  <div class="idle-links">
    <a href="/omarchy/">向 Omarchy 致敬 <span aria-hidden="true">↗</span></a>
    <div><a href="/experiments/wordlight/">旧日字光 ↗</a><button type="button" data-idle-pause hidden aria-label="暂停字标动画">暂停</button></div>
  </div>
</div>
<script>
  import {attachIdleHero} from '../scripts/idle-hero.js';
  const stage=document.querySelector('[data-idle-hero]');
  if(stage) attachIdleHero(stage);
</script>
<style>
  .idle-hero{position:relative;background:#000;color:#eee;isolation:isolate}
  .idle-hero h1{padding:54px 12px;font-size:clamp(32px,9cqi,100px);color:#eee}
  .idle-words{display:none;grid-template-columns:repeat(3,minmax(0,1fr));align-items:center;height:clamp(120px,21cqi,260px);padding:0 18px}
  .idle-words canvas{width:100%;height:100%;min-width:0;object-fit:contain}
  .idle-hero[data-ready=true] h1{position:absolute;width:1px;height:1px;clip-path:inset(50%);overflow:hidden;padding:0}
  .idle-hero[data-ready=true] .idle-words{display:grid}
  .idle-links{display:flex;justify-content:space-between;align-items:center;padding:0 22px 10px;gap:12px;font:11px/1.5 var(--font-sans);color:#a4aca0;text-align:left}
  .idle-links>div{display:flex;align-items:center;gap:20px}.idle-links a,.idle-links button{display:inline-flex;align-items:center;min-height:44px;gap:6px}.idle-links button{border:0;background:none;padding:0;color:inherit;min-width:30px}.idle-links :is(a,button):hover{color:#c1f08c}
  @media(max-width:700px){.idle-words{padding:0 2px;height:110px}.idle-links{font-size:10px;padding:0 12px 4px}.idle-links>div{gap:14px}.idle-hero h1{padding:35px 6px}}
</style>
