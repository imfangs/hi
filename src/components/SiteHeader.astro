---
import BrandMark from './BrandMark.astro';
---
<header class="site-header shell" id="top">
  <a href="/" class="brand" aria-label="fangs 作品集首页"><BrandMark id="header" /><span class="brand-name">fangs.</span></a>
  <nav aria-label="主导航">
    <a href="/#works">作品</a>
    <a href="/#about">关于</a>
    <a href="/#contact">联系</a>
    <div class="theme-control" hidden>
      <button class="theme-trigger" type="button" aria-label="配色：跟随系统" aria-expanded="false" aria-controls="theme-options" title="切换配色">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"/></svg>
      </button>
      <div class="theme-options" id="theme-options" hidden role="group" aria-label="选择配色">
        <button type="button" data-theme="system" aria-pressed="true">跟随系统</button>
        <button type="button" data-theme="light" aria-pressed="false">浅色</button>
        <button type="button" data-theme="dark" aria-pressed="false">深色</button>
      </div>
    </div>
  </nav>
</header>
<script>import '../scripts/theme';</script>
